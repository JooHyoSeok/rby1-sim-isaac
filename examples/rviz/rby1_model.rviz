Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RBY1
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: table and box
      Enabled: true
      Topic:
        Value: /rby1/scene_markers
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: stereo_right
      Enabled: true
      Topic:
        Value: /rby1/stereo_right/image_raw
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: wrist_left
      Enabled: true
      Topic:
        Value: /rby1/wrist_left/image_raw
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: wrist_right
      Enabled: true
      Topic:
        Value: /rby1/wrist_right/image_raw
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.4
      Focal Point: {X: 0.4, Y: 0, Z: 0.7}
      Pitch: 0.35
      Yaw: 0.9
    Saved: ~
